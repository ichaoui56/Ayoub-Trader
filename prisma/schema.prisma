generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PrivateServiceKind {
  OUTING
  PRIVATE_VISIT
  CHAUFFEUR
}

enum TransferServiceType {
  AIRPORT_ROUTE
  PRIVATE_SERVICE
  CUSTOM_ROUTE
}

enum TransferRequestStatus {
  NEW
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum ActivityReservationStatus {
  NEW
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum UserRole {
  ADMIN
  STAFF
}

enum PrivateRoomRequestStatus {
  SUBMITTED
  DEPOSIT_VERIFIED
  VIP_ACTIVE
  REJECTED
  EXPIRED
}

enum CopyTradingStatus {
  NEW
  UNDER_REVIEW
  AUTHORIZATION_PENDING
  AUTHORIZED
  ACTIVE
  PAUSED
  REJECTED
}

enum CoachingPackage {
  STARTER
  ADVANCED
  PREMIUM
}

enum CoachingBookingStatus {
  PENDING
  CONFIRMED
  ACTIVE
  COMPLETED
  REJECTED
  CANCELLED
  EXPIRED
}

enum CoachingSessionStatus {
  SCHEDULED
  COMPLETED
  MISSED
  CANCELLED
}

enum ManualPaymentStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum ManualPaymentService {
  PRIVATE_ROOM
  COPY_TRADING
  COACHING
}

enum CoachingSlotKind {
  RESERVED
  BLOCKED
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  role         UserRole @default(STAFF)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  verifiedPayments ManualPayment[] @relation("PaymentVerifier")

  @@index([role, isActive])
}

model TransferRoute {
  id        String            @id @default(cuid())
  from      String
  fromFr    String?
  to        String
  toFr      String?
  price     Float
  notes     String            @default("")
  notesFr   String            @default("")
  currency  String            @default("EUR")
  isActive  Boolean           @default(true)
  sortOrder Int               @default(0)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  requests  TransferRequest[]

  @@unique([from, to])
  @@index([isActive, sortOrder])
}

model PrivateTransferService {
  id             String             @id @default(cuid())
  name           String             @unique
  nameFr         String?
  kind           PrivateServiceKind @default(OUTING)
  description    String
  descriptionFr  String             @default("")
  price          Float
  currency       String             @default("EUR")
  passengerLimit Int                @default(8)
  duration       String             @default("À définir")
  durationFr     String             @default("")
  startTimes     String[]           @default([])
  image          String             @default("")
  imageAlt       String             @default("")
  imageAltFr     String             @default("")
  isActive       Boolean            @default(true)
  sortOrder      Int                @default(0)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  requests       TransferRequest[]

  @@index([isActive, sortOrder])
}

model TransferLocation {
  id          String   @id @default(cuid())
  name        String   @unique
  nameFr      String?
  isActive    Boolean  @default(true)
  isDeparture Boolean  @default(true)
  isArrival   Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, sortOrder])
}

model TransferSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model ActivityCatalogItem {
  id        String   @id @default(cuid())
  slug      String   @unique
  data      Json
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}

model ActivitySetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model BlogCatalogItem {
  id          String   @id @default(cuid())
  slug        String   @unique
  data        Json
  isPublished Boolean  @default(false)
  publishedAt DateTime @default(now())
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished, publishedAt, sortOrder])
}

model BlogSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model ConciergeSetting {
  id        String   @id @default("homepage")
  data      Json
  updatedAt DateTime @updatedAt
}

model ActivityReservation {
  id                    String                     @id @default(cuid())
  status                ActivityReservationStatus  @default(NEW)
  customerName          String
  customerPhone         String
  customerEmail         String?
  hotelAddress          String?
  notes                 String?
  estimatedTotal        Float
  currency              String                     @default("EUR")
  priceNeedsConfirmation Boolean                   @default(false)
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  lines                 ActivityReservationLine[]

  @@index([status, createdAt])
}

model ActivityReservationLine {
  id               String                       @id @default(cuid())
  reservationId    String
  reservation      ActivityReservation          @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  activitySlug     String
  activityTitle    String
  activityLocation String
  activityImage    String                       @default("")
  rateLabel        String
  rateUnit         String
  rateBilling      String
  ratePrice        Float
  adults           Int
  children         Int                           @default(0)
  date             DateTime                      @db.Date
  time             String
  extras           Json
  lineTotal        Float
  slots            ConfirmedActivitySlot[]

  @@index([activitySlug, date, time])
}

model ConfirmedActivitySlot {
  id                String                 @id @default(cuid())
  activitySlug      String
  date              DateTime               @db.Date
  time              String
  reservationLineId String                 @unique
  reservationLine   ActivityReservationLine @relation(fields: [reservationLineId], references: [id], onDelete: Cascade)

  @@unique([activitySlug, date, time])
}

model TransferRequest {
  id               String                  @id @default(cuid())
  serviceType      TransferServiceType
  status           TransferRequestStatus   @default(NEW)
  serviceName      String
  routeId          String?
  route            TransferRoute?          @relation(fields: [routeId], references: [id], onDelete: SetNull)
  privateServiceId String?
  privateService   PrivateTransferService? @relation(fields: [privateServiceId], references: [id], onDelete: SetNull)
  departure        String
  arrival          String
  priceAtRequest   Float?
  currency         String                  @default("EUR")
  serviceDate      DateTime
  serviceTime      String?
  passengerCount   Int
  luggageCount     Int                     @default(0)
  hotelAddress     String?
  flightNumber     String?
  customerName     String
  customerPhone    String
  customerEmail    String?
  notes            String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@index([status, createdAt])
  @@index([serviceDate])
}

model TradingCustomer {
  id                     String                    @id @default(cuid())
  name                   String
  phone                  String                    @unique
  email                  String?
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt
  privateRoomRequests    PrivateRoomRequest[]
  copyTradingApplications CopyTradingApplication[]
  coachingBookings       CoachingBooking[]
  payments               ManualPayment[]

  @@index([name])
}

model PrivateRoomRequest {
  id                 String                    @id @default(cuid())
  customerId         String
  customer           TradingCustomer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  status             PrivateRoomRequestStatus  @default(SUBMITTED)
  depositProof       Bytes?
  depositProofMime   String?
  depositProofName   String?
  depositVerifiedAt  DateTime?
  vipGrantedAt       DateTime?
  vipExpiresAt       DateTime?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  payments           ManualPayment[]

  @@index([status, createdAt])
  @@index([customerId, createdAt])
}

model CopyTradingApplication {
  id             String           @id @default(cuid())
  customerId     String
  customer       TradingCustomer  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  brokerName     String
  accountBalance Decimal          @db.Decimal(12, 2)
  status         CopyTradingStatus @default(NEW)
  reviewedAt     DateTime?
  authorizedAt   DateTime?
  activatedAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  payments       ManualPayment[]

  @@index([status, createdAt])
  @@index([customerId, createdAt])
}

model CoachingBooking {
  id               String                @id @default(cuid())
  customerId       String
  customer         TradingCustomer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  package          CoachingPackage
  status           CoachingBookingStatus @default(PENDING)
  priceDh          Int
  startDate        DateTime              @db.Date
  endDate          DateTime              @db.Date
  dailyStartMinute Int
  durationMinutes  Int
  expectedSessions Int
  remainingSessions Int
  activatedAt      DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  sessions         CoachingSession[]
  payments         ManualPayment[]

  @@index([status, createdAt])
  @@index([customerId, createdAt])
  @@index([startDate, endDate])
}

model CoachingSession {
  id               String                 @id @default(cuid())
  bookingId        String
  booking          CoachingBooking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  date             DateTime               @db.Date
  startMinute      Int
  durationMinutes  Int
  status           CoachingSessionStatus  @default(SCHEDULED)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  timeSlots        CoachingTimeSlot[]

  @@unique([bookingId, date])
  @@index([date, startMinute])
  @@index([status, date])
}

model CoachingAvailabilityBlock {
  id          String              @id @default(cuid())
  date        DateTime            @db.Date
  startMinute Int
  endMinute   Int
  reason      String              @default("")
  createdAt   DateTime            @default(now())
  timeSlots   CoachingTimeSlot[]

  @@index([date, startMinute])
}

model CoachingTimeSlot {
  id         String                   @id @default(cuid())
  date       DateTime                 @db.Date
  quarter    Int
  kind       CoachingSlotKind
  sessionId  String?
  session    CoachingSession?         @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  blockId    String?
  block      CoachingAvailabilityBlock? @relation(fields: [blockId], references: [id], onDelete: Cascade)

  @@unique([date, quarter])
  @@index([sessionId])
  @@index([blockId])
}

model ManualPayment {
  id                   String                @id @default(cuid())
  customerId           String
  customer             TradingCustomer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  service              ManualPaymentService
  privateRoomRequestId String?
  privateRoomRequest   PrivateRoomRequest?   @relation(fields: [privateRoomRequestId], references: [id], onDelete: Cascade)
  copyTradingApplicationId String?
  copyTradingApplication CopyTradingApplication? @relation(fields: [copyTradingApplicationId], references: [id], onDelete: Cascade)
  coachingBookingId    String?
  coachingBooking      CoachingBooking?      @relation(fields: [coachingBookingId], references: [id], onDelete: Cascade)
  amount               Decimal               @db.Decimal(10, 2)
  currency             String
  status               ManualPaymentStatus   @default(PENDING)
  note                 String                @default("")
  verifiedAt           DateTime?
  verifiedById         String?
  verifiedBy           User?                 @relation("PaymentVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([status, createdAt])
  @@index([customerId, createdAt])
  @@index([copyTradingApplicationId])
  @@index([service, status])
}
