generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PrivateServiceKind {
  OUTING
  PRIVATE_VISIT
  CHAUFFEUR
}

enum TransferServiceType {
  AIRPORT_ROUTE
  PRIVATE_SERVICE
  CUSTOM_ROUTE
}

enum TransferRequestStatus {
  NEW
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum ActivityReservationStatus {
  NEW
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum UserRole {
  ADMIN
  STAFF
}

enum PrivateRoomRequestStatus {
  SUBMITTED
  DEPOSIT_VERIFIED
  VIP_ACTIVE
  REJECTED
  EXPIRED
  PROOF_REPORTED
  UNDER_REVIEW
  MORE_INFO_REQUIRED
  CANCELLED
  SUSPENDED
}

enum VipBrokerOption {
  OUR_BROKER
  OWN_BROKER
}

enum VipMembershipStatus {
  ACTIVE
  SUSPENDED
  EXPIRED
  ENDED
}

enum CopyTradingStatus {
  NEW
  UNDER_REVIEW
  AUTHORIZATION_PENDING
  AUTHORIZED
  ACTIVE
  PAUSED
  REJECTED
}

enum CoachingPackage {
  STARTER
  ADVANCED
  PREMIUM
}

enum CoachingMeetingMode {
  ONLINE
  IN_PERSON
}

enum CoachingBookingStatus {
  PENDING
  CONFIRMED
  ACTIVE
  COMPLETED
  REJECTED
  CANCELLED
  EXPIRED
}

enum CoachingSessionStatus {
  SCHEDULED
  COMPLETED
  MISSED
  CANCELLED
}

enum ManualPaymentStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum ManualPaymentService {
  PRIVATE_ROOM
  COPY_TRADING
  COACHING
}

enum FinancialTransactionType {
  DEPOSIT
  WITHDRAWAL
  PROFIT
  PROFIT_SHARE
}

enum FinancialTransactionStatus {
  PENDING
  VERIFIED
  REJECTED
  COMPLETED
}

enum CoachingSlotKind {
  RESERVED
  BLOCKED
}

model User {
  id                            String                 @id @default(cuid())
  username                      String                 @unique
  email                         String?                @unique
  passwordHash                  String
  role                          UserRole               @default(STAFF)
  isActive                      Boolean                @default(true)
  createdAt                     DateTime               @default(now())
  updatedAt                     DateTime               @updatedAt
  verifiedPayments              ManualPayment[]        @relation("PaymentVerifier")
  activatedVipMemberships       VipMembership[]        @relation("VipMembershipActivator")
  vipAuditLogs                  VipAuditLog[]
  financialTransactionsCreated  FinancialTransaction[] @relation("FinancialTransactionCreator")
  financialTransactionsReviewed FinancialTransaction[] @relation("FinancialTransactionReviewer")

  @@index([role, isActive])
}

model TradingCustomer {
  id                      String                   @id @default(cuid())
  clientId                String                   @unique @default(dbgenerated("('VIP-' || to_char(CURRENT_DATE, 'YYYY') || '-' || replace(gen_random_uuid()::text, '-', ''))"))
  name                    String
  phone                   String                   @unique
  email                   String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  privateRoomRequests     PrivateRoomRequest[]
  copyTradingApplications CopyTradingApplication[]
  coachingBookings        CoachingBooking[]
  payments                ManualPayment[]
  financialTransactions   FinancialTransaction[]
  account                 TradingCustomerAccount?
  memberships             VipMembership[]
  roomAssignments         VipRoomAssignment[]
  notifications           VipNotification[]

  @@index([name])
}

model PrivateRoomRequest {
  id                String                   @id @default(cuid())
  customerId        String
  customer          TradingCustomer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  status            PrivateRoomRequestStatus @default(SUBMITTED)
  brokerOption      VipBrokerOption          @default(OUR_BROKER)
  proofReportedAt   DateTime?
  adminFeedback     String?
  depositProof      Bytes?
  depositProofMime  String?
  depositProofName  String?
  depositVerifiedAt DateTime?
  vipGrantedAt      DateTime?
  vipExpiresAt      DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  payments          ManualPayment[]
  memberships       VipMembership[]

  @@index([status, createdAt])
  @@index([customerId, createdAt])
}

model TradingCustomerAccount {
  id                    String          @id @default(cuid())
  customerId            String          @unique
  customer              TradingCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  username              String          @unique
  email                 String          @unique
  passwordHash          String
  failedLoginCount      Int             @default(0)
  lockedUntil           DateTime?
  emailVerifiedAt       DateTime?
  verificationTokenHash String?
  verificationExpiresAt DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@index([emailVerifiedAt])
}

model VipMembership {
  id            String              @id @default(cuid())
  customerId    String
  customer      TradingCustomer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  applicationId String              @unique
  application   PrivateRoomRequest  @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  brokerOption  VipBrokerOption
  status        VipMembershipStatus @default(ACTIVE)
  startsAt      DateTime
  expiresAt     DateTime
  activatedById String?
  activatedBy   User?               @relation("VipMembershipActivator", fields: [activatedById], references: [id], onDelete: SetNull)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  assignments   VipRoomAssignment[]

  @@index([customerId, status, expiresAt])
  @@index([status, expiresAt])
}

model VipRoom {
  id           String                 @id @default(cuid())
  slug         String                 @unique
  name         String
  description  String                 @default("")
  category     String                 @default("General")
  coverImage   String                 @default("")
  isPublished  Boolean                @default(false)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  assignments  VipRoomAssignment[]
  posts        VipRoomPost[]
  transactions FinancialTransaction[]

  @@index([isPublished, category])
}

model VipRoomAssignment {
  id           String          @id @default(cuid())
  customerId   String
  customer     TradingCustomer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  membershipId String
  membership   VipMembership   @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  roomId       String
  room         VipRoom         @relation(fields: [roomId], references: [id], onDelete: Restrict)
  assignedAt   DateTime        @default(now())
  revokedAt    DateTime?

  @@unique([membershipId, roomId])
  @@index([customerId, revokedAt])
  @@index([roomId, revokedAt])
}

model VipRoomPost {
  id          String              @id @default(cuid())
  roomId      String
  room        VipRoom             @relation(fields: [roomId], references: [id], onDelete: Cascade)
  title       String
  body        String
  isPinned    Boolean             @default(false)
  publishedAt DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  attachments VipRoomAttachment[]

  @@index([roomId, publishedAt, isPinned])
}

model VipRoomAttachment {
  id        String      @id @default(cuid())
  postId    String
  post      VipRoomPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  filename  String
  mimeType  String
  bytes     Bytes
  createdAt DateTime    @default(now())

  @@index([postId])
}

model VipNotification {
  id         String          @id @default(cuid())
  customerId String
  customer   TradingCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  title      String
  message    String
  readAt     DateTime?
  createdAt  DateTime        @default(now())

  @@index([customerId, readAt, createdAt])
}

model VipPlatformSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model VipAuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  subjectId String?
  details   Json?
  createdAt DateTime @default(now())

  @@index([action, createdAt])
  @@index([subjectId, createdAt])
}

model CopyTradingApplication {
  id                      String                 @id @default(cuid())
  customerId              String
  customer                TradingCustomer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  brokerName              String
  accountBalance          Decimal                @db.Decimal(12, 2)
  brokerLogin             String?
  brokerPasswordEncrypted String?
  serverName              String?
  serverIp                String?
  internalNote            String?
  status                  CopyTradingStatus      @default(NEW)
  reviewedAt              DateTime?
  authorizedAt            DateTime?
  activatedAt             DateTime?
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  payments                ManualPayment[]
  financialTransactions   FinancialTransaction[]

  @@index([status, createdAt])
  @@index([customerId, createdAt])
}

model CoachingBooking {
  id                String                @id @default(cuid())
  customerId        String
  customer          TradingCustomer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  package           CoachingPackage
  meetingMode       CoachingMeetingMode   @default(ONLINE)
  meetingCity       String?
  status            CoachingBookingStatus @default(PENDING)
  priceDh           Int
  startDate         DateTime              @db.Date
  endDate           DateTime              @db.Date
  dailyStartMinute  Int
  durationMinutes   Int
  expectedSessions  Int
  remainingSessions Int
  activatedAt       DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  sessions          CoachingSession[]
  payments          ManualPayment[]

  @@index([status, createdAt])
  @@index([customerId, createdAt])
  @@index([startDate, endDate])
}

model CoachingSession {
  id              String                @id @default(cuid())
  bookingId       String
  booking         CoachingBooking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  date            DateTime              @db.Date
  startMinute     Int
  durationMinutes Int
  status          CoachingSessionStatus @default(SCHEDULED)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  timeSlots       CoachingTimeSlot[]

  @@unique([bookingId, date])
  @@index([date, startMinute])
  @@index([status, date])
}

model CoachingAvailabilityBlock {
  id          String             @id @default(cuid())
  date        DateTime           @db.Date
  startMinute Int
  endMinute   Int
  reason      String             @default("")
  createdAt   DateTime           @default(now())
  timeSlots   CoachingTimeSlot[]

  @@index([date, startMinute])
}

model CoachingTimeSlot {
  id        String                     @id @default(cuid())
  date      DateTime                   @db.Date
  quarter   Int
  kind      CoachingSlotKind
  sessionId String?
  session   CoachingSession?           @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  blockId   String?
  block     CoachingAvailabilityBlock? @relation(fields: [blockId], references: [id], onDelete: Cascade)

  @@unique([date, quarter])
  @@index([sessionId])
  @@index([blockId])
}

model ManualPayment {
  id                       String                  @id @default(cuid())
  customerId               String
  customer                 TradingCustomer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  service                  ManualPaymentService
  privateRoomRequestId     String?
  privateRoomRequest       PrivateRoomRequest?     @relation(fields: [privateRoomRequestId], references: [id], onDelete: Cascade)
  copyTradingApplicationId String?
  copyTradingApplication   CopyTradingApplication? @relation(fields: [copyTradingApplicationId], references: [id], onDelete: Cascade)
  coachingBookingId        String?
  coachingBooking          CoachingBooking?        @relation(fields: [coachingBookingId], references: [id], onDelete: Cascade)
  amount                   Decimal                 @db.Decimal(10, 2)
  currency                 String
  status                   ManualPaymentStatus     @default(PENDING)
  note                     String                  @default("")
  verifiedAt               DateTime?
  verifiedById             String?
  verifiedBy               User?                   @relation("PaymentVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt

  @@index([status, createdAt])
  @@index([customerId, createdAt])
  @@index([copyTradingApplicationId])
  @@index([service, status])
}

model FinancialTransaction {
  id                       String                     @id @default(cuid())
  customerId               String
  customer                 TradingCustomer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  roomId                   String?
  room                     VipRoom?                   @relation(fields: [roomId], references: [id], onDelete: SetNull)
  copyTradingApplicationId String?
  copyTradingApplication   CopyTradingApplication?    @relation(fields: [copyTradingApplicationId], references: [id], onDelete: Restrict)
  createdById              String?
  createdBy                User?                      @relation("FinancialTransactionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  reviewedById             String?
  reviewedBy               User?                      @relation("FinancialTransactionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  type                     FinancialTransactionType
  amount                   Decimal                    @db.Decimal(12, 2)
  currency                 String                     @default("USD")
  status                   FinancialTransactionStatus @default(PENDING)
  reference                String?                    @unique
  notes                    String                     @default("")
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt

  @@index([type, status, createdAt])
  @@index([customerId, type, createdAt])
  @@index([roomId, type, createdAt])
}
