generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PrivateServiceKind {
  OUTING
  PRIVATE_VISIT
  CHAUFFEUR
}

enum TransferServiceType {
  AIRPORT_ROUTE
  PRIVATE_SERVICE
  CUSTOM_ROUTE
}

enum TransferRequestStatus {
  NEW
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum UserRole {
  ADMIN
  STAFF
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  role         UserRole @default(STAFF)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([role, isActive])
}

model TransferRoute {
  id        String            @id @default(cuid())
  from      String
  to        String
  price     Float
  notes     String            @default("")
  currency  String            @default("EUR")
  isActive  Boolean           @default(true)
  sortOrder Int               @default(0)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  requests  TransferRequest[]

  @@unique([from, to])
  @@index([isActive, sortOrder])
}

model PrivateTransferService {
  id             String             @id @default(cuid())
  name           String             @unique
  kind           PrivateServiceKind @default(OUTING)
  description    String
  price          Float
  currency       String             @default("EUR")
  passengerLimit Int                @default(8)
  duration       String             @default("À définir")
  startTimes     String[]           @default([])
  image          String             @default("")
  imageAlt       String             @default("")
  isActive       Boolean            @default(true)
  sortOrder      Int                @default(0)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  requests       TransferRequest[]

  @@index([isActive, sortOrder])
}

model TransferLocation {
  id          String   @id @default(cuid())
  name        String   @unique
  isActive    Boolean  @default(true)
  isDeparture Boolean  @default(true)
  isArrival   Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, sortOrder])
}

model TransferSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model TransferRequest {
  id               String                  @id @default(cuid())
  serviceType      TransferServiceType
  status           TransferRequestStatus   @default(NEW)
  serviceName      String
  routeId          String?
  route            TransferRoute?          @relation(fields: [routeId], references: [id], onDelete: SetNull)
  privateServiceId String?
  privateService   PrivateTransferService? @relation(fields: [privateServiceId], references: [id], onDelete: SetNull)
  departure        String
  arrival          String
  priceAtRequest   Float?
  currency         String                  @default("EUR")
  serviceDate      DateTime
  serviceTime      String?
  passengerCount   Int
  luggageCount     Int                     @default(0)
  hotelAddress     String?
  flightNumber     String?
  customerName     String
  customerPhone    String
  customerEmail    String?
  notes            String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@index([status, createdAt])
  @@index([serviceDate])
}
